# Optional hosted generation (Tripo only, ADR-018). The local procedural provider works without any of these values.
# Tripo is enabled only if its flag AND key are set AND an access code is set (fail closed).
# Tripo is UNVERIFIED until a real-account smoke test is recorded (docs/DEPLOYMENT.md).

# Shared secret users must enter in the app before any paid request. Anyone with this code can spend your Tripo credits.
SIFT_ACCESS_CODE=
# Optional cap on paid generations per day per server instance (default 20).
SIFT_DAILY_LIMIT=20

# Tripo
TRIPO_ENABLED=false
TRIPO_API_KEY=
