# Optional hosted generation (Meshy). Procedural mode works without any of these values.
# Hosted generation is disabled unless ALL THREE of enabled, key, and access code are set.
MESHY_ENABLED=false
MESHY_API_KEY=
# Shared secret users must enter in the app before a paid request. Anyone with this code can spend your Meshy credits.
MESHY_ACCESS_CODE=
# Optional cap on paid generations per day per server instance (default 20).
MESHY_DAILY_LIMIT=20
