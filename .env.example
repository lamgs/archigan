# Optional hosted generation. The local procedural provider works without any of these values.
# Each hosted provider is enabled only if its own flag AND key are set AND a shared access code is set (fail closed).
# Every hosted provider is UNVERIFIED until a real-account smoke test is recorded (docs/DEPLOYMENT.md).

# Shared secret users must enter in the app before any paid request. Anyone with this code can spend your credits
# on every enabled provider. MESHY_ACCESS_CODE is still honoured as a fallback when SIFT_ACCESS_CODE is unset.
SIFT_ACCESS_CODE=
# Optional cap on paid generations per day per server instance, counted across ALL providers (default 20).
# MESHY_DAILY_LIMIT is still honoured as a fallback.
SIFT_DAILY_LIMIT=20

# Meshy
MESHY_ENABLED=false
MESHY_API_KEY=

# Tripo
TRIPO_ENABLED=false
TRIPO_API_KEY=

# Hunyuan3D via fal.ai (enables both the Rapid and Pro tiers)
HUNYUAN_ENABLED=false
FAL_KEY=
